{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "livestudio-pro",
  "version": "1.0.0",
  "identifier": "com.livestudio.pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Live Studio Pro - Live Production Software",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Professional Live Video Production Application and vMix Alternative",
    "longDescription": "LiveStudio Pro is a professional broadcast production switcher featuring native GStreamer media pipelines, dual-bus switching, hardware transitions, RTMP/SRT streaming, multi-camera ISO recording, DSP audio mixing, vector graphic overlays, instant replay, PTZ camera control, and safety-governed automation.",
    "linux": {
      "deb": {
        "depends": [
          "libgstreamer1.0-0 (>= 1.18.0)",
          "libgstreamer-plugins-base1.0-0 (>= 1.18.0)",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "libasound2",
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"
        ],
        "section": "video"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
